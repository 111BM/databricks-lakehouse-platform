{
  "datasets": [
    {
      "name": "kpi_30d",
      "displayName": "KPIs: last 30 days vs previous 30 days",
      "queryLines": [
        "-- Trailing 30 days vs the 30 before, ending at the last order date in the data.\n",
        "-- A single day is a poor KPI window here: the newest day can be a partial\n",
        "-- load (a handful of rows), which turned \"latest day revenue\" into $0.00M.\n",
        "WITH bounds AS (\n",
        "  SELECT MAX(order_date) AS last_day FROM metrics_daily_kpi\n",
        "),\n",
        "periods AS (\n",
        "  SELECT\n",
        "    SUM(IF(d.order_date >  DATE_SUB(b.last_day, 30), d.total_sales,  0)) AS sales_cur,\n",
        "    SUM(IF(d.order_date <= DATE_SUB(b.last_day, 30), d.total_sales,  0)) AS sales_prev,\n",
        "    SUM(IF(d.order_date >  DATE_SUB(b.last_day, 30), d.total_profit, 0)) AS profit_cur,\n",
        "    SUM(IF(d.order_date <= DATE_SUB(b.last_day, 30), d.total_profit, 0)) AS profit_prev,\n",
        "    MAX(b.last_day) AS last_day\n",
        "  FROM metrics_daily_kpi d\n",
        "  CROSS JOIN bounds b\n",
        "  WHERE d.order_date > DATE_SUB(b.last_day, 60)\n",
        "),\n",
        "calc AS (\n",
        "  SELECT\n",
        "    *,\n",
        "    -- ABS() in the denominator keeps the arrow honest when profit is negative:\n",
        "    -- a loss shrinking from -100 to -80 is an improvement (+20%), not -20%.\n",
        "    (sales_cur  - sales_prev)  / NULLIF(ABS(sales_prev), 0)  AS sales_change,\n",
        "    (profit_cur - profit_prev) / NULLIF(ABS(profit_prev), 0) AS profit_change,\n",
        "    profit_cur  / NULLIF(sales_cur, 0)  AS margin_cur,\n",
        "    profit_prev / NULLIF(sales_prev, 0) AS margin_prev\n",
        "  FROM periods\n",
        ")\n",
        "SELECT\n",
        "  sales_cur  AS revenue,\n",
        "  profit_cur AS profit,\n",
        "  margin_cur AS margin,\n",
        "  CONCAT(IF(sales_change  >= 0, '▲ ', '▼ '), FORMAT_NUMBER(ABS(sales_change)  * 100, 1), '%') AS revenue_change,\n",
        "  CONCAT(IF(profit_change >= 0, '▲ ', '▼ '), FORMAT_NUMBER(ABS(profit_change) * 100, 1), '%') AS profit_change,\n",
        "  -- Margin moves in percentage points; a \"% change of a margin\" is unreadable.\n",
        "  CONCAT(IF(margin_cur >= margin_prev, '▲ ', '▼ '),\n",
        "         FORMAT_NUMBER(ABS(margin_cur - margin_prev) * 100, 2), ' pp') AS margin_change,\n",
        "  DATE_FORMAT(last_day, 'd MMM yyyy') AS data_through\n",
        "FROM calc\n"
      ]
    },
    {
      "name": "weekly",
      "displayName": "Weekly sales, profit and margin",
      "queryLines": [
        "-- Complete weeks only, so a partially loaded final week does not plunge the trend.\n",
        "SELECT\n",
        "  DATE_TRUNC('WEEK', order_date)          AS week,\n",
        "  SUM(total_sales)                        AS sales,\n",
        "  SUM(total_profit)                       AS profit,\n",
        "  SUM(total_profit) / SUM(total_sales)    AS margin\n",
        "FROM metrics_daily_kpi\n",
        "GROUP BY 1\n",
        "HAVING COUNT(*) = 7\n"
      ]
    },
    {
      "name": "refreshed",
      "displayName": "When the tables behind this dashboard were last written",
      "queryLines": [
        "-- last_altered moves on every write, so this is when the pipeline last refreshed\n",
        "-- these tables. current_schema() is the dataset schema the bundle sets per\n",
        "-- environment, so dev, qa and prod each report their own tables.\n",
        "SELECT\n",
        "  CONCAT(FORMAT_NUMBER((unix_timestamp(current_timestamp()) - unix_timestamp(MAX(last_altered))) / 3600.0, 1), ' h ago') AS refreshed\n",
        "FROM information_schema.tables\n",
        "WHERE table_schema = current_schema()\n",
        "  AND table_name IN ('metrics_daily_kpi', 'product_insights_kpi')\n"
      ]
    },
    {
      "name": "category_mix",
      "displayName": "Sales by category",
      "queryLines": [
        "SELECT category, SUM(total_sales) AS sales, SUM(total_profit) AS profit\n",
        "FROM product_insights_kpi\n",
        "WHERE category <> 'Unknown'\n",
        "GROUP BY category\n"
      ]
    },
    {
      "name": "top_subcategories",
      "displayName": "Top 15 sub-categories by revenue",
      "queryLines": [
        "-- Top 15 only: the generator also emits ~250k one-off \"Random Product\" rows,\n",
        "-- each with its own numeric sub-category, which would bury the real ones.\n",
        "SELECT category, sub_category, SUM(total_sales) AS sales\n",
        "FROM product_insights_kpi\n",
        "WHERE category <> 'Unknown'\n",
        "GROUP BY category, sub_category\n",
        "ORDER BY sales DESC\n",
        "LIMIT 15\n"
      ]
    }
  ],
