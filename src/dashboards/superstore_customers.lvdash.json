{
  "datasets": [
    {
      "name": "customers",
      "displayName": "Customers",
      "queryLines": [
        "-- One row per customer. 'Unknown' is the placeholder dimension row that keeps\n",
        "-- facts with an unresolved customer joinable (docs/REFERENTIAL_COMPLETENESS.md);\n",
        "-- it is not a real region or segment, so it is kept out of the business view.\n",
        "SELECT customer_id, customer_name, region, segment, total_sales, total_profit, total_orders\n",
        "FROM customer_kpi\n",
        "WHERE region <> 'Unknown'\n",
        "  AND segment <> 'Unknown'\n"
      ]
    },
    {
      "name": "top_customers",
      "displayName": "Top 10 customers per region",
      "queryLines": [
        "SELECT\n",
        "  region_sales_rank AS rank,\n",
        "  customer_name,\n",
        "  region,\n",
        "  segment,\n",
        "  total_sales,\n",
        "  total_profit,\n",
        "  total_orders\n",
        "FROM customer_kpi\n",
        "WHERE region <> 'Unknown'\n",
        "  AND segment <> 'Unknown'\n",
        "  AND region_sales_rank <= 10\n",
        "ORDER BY region, region_sales_rank\n"
      ]
    },
    {
      "name": "refreshed",
      "displayName": "When the tables behind this dashboard were last written",
      "queryLines": [
        "-- last_altered moves on every write, so this is when the pipeline last refreshed\n",
        "-- these tables. current_schema() is the dataset schema the bundle sets per\n",
        "-- environment, so dev, qa and prod each report their own tables.\n",
        "SELECT\n",
        "  CONCAT(FORMAT_NUMBER((unix_timestamp(current_timestamp()) - unix_timestamp(MAX(last_altered))) / 3600.0, 1), ' h ago') AS refreshed\n",
        "FROM information_schema.tables\n",
        "WHERE table_schema = current_schema()\n",
        "  AND table_name IN ('customer_kpi')\n"
      ]
    }
  ],
