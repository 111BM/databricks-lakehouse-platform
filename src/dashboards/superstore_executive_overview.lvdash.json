{
  "datasets": [
    {
      "name": "kpi_30d",
      "displayName": "KPIs: last 30 days vs previous 30 days",
      "queryLines": [
        "-- Trailing 30 days vs the 30 before, ending at the last order date in the data.\n",
        "-- A single day is a poor KPI window here: the newest day can be a partial\n",
        "-- load (a handful of rows), which turned \"latest day revenue\" into $0.00M.\n",
        "WITH bounds AS (\n",
        "  SELECT MAX(order_date) AS last_day FROM metrics_daily_kpi\n",
        "),\n",
        "periods AS (\n",
        "  SELECT\n",
        "    SUM(IF(d.order_date >  DATE_SUB(b.last_day, 30), d.total_sales,  0)) AS sales_cur,\n",
        "    SUM(IF(d.order_date <= DATE_SUB(b.last_day, 30), d.total_sales,  0)) AS sales_prev,\n",
        "    SUM(IF(d.order_date >  DATE_SUB(b.last_day, 30), d.total_profit, 0)) AS profit_cur,\n",
        "    SUM(IF(d.order_date <= DATE_SUB(b.last_day, 30), d.total_profit, 0)) AS profit_prev,\n",
        "    MAX(b.last_day) AS last_day\n",
        "  FROM metrics_daily_kpi d\n",
        "  CROSS JOIN bounds b\n",
        "  WHERE d.order_date > DATE_SUB(b.last_day, 60)\n",
        "),\n",
        "calc AS (\n",
        "  SELECT\n",
        "    *,\n",
        "    -- ABS() in the denominator keeps the arrow honest when profit is negative:\n",
        "    -- a loss shrinking from -100 to -80 is an improvement (+20%), not -20%.\n",
        "    (sales_cur  - sales_prev)  / NULLIF(ABS(sales_prev), 0)  AS sales_change,\n",
        "    (profit_cur - profit_prev) / NULLIF(ABS(profit_prev), 0) AS profit_change,\n",
        "    profit_cur  / NULLIF(sales_cur, 0)  AS margin_cur,\n",
        "    profit_prev / NULLIF(sales_prev, 0) AS margin_prev\n",
        "  FROM periods\n",
        ")\n",
        "SELECT\n",
        "  sales_cur  AS revenue,\n",
        "  profit_cur AS profit,\n",
        "  margin_cur AS margin,\n",
        "  CONCAT(IF(sales_change  >= 0, '▲ ', '▼ '), FORMAT_NUMBER(ABS(sales_change)  * 100, 1), '%') AS revenue_change,\n",
        "  CONCAT(IF(profit_change >= 0, '▲ ', '▼ '), FORMAT_NUMBER(ABS(profit_change) * 100, 1), '%') AS profit_change,\n",
        "  -- Margin moves in percentage points; a \"% change of a margin\" is unreadable.\n",
        "  CONCAT(IF(margin_cur >= margin_prev, '▲ ', '▼ '),\n",
        "         FORMAT_NUMBER(ABS(margin_cur - margin_prev) * 100, 2), ' pp') AS margin_change,\n",
        "  DATE_FORMAT(last_day, 'd MMM yyyy') AS data_through\n",
        "FROM calc\n"
      ]
    },
    {
      "name": "weekly",
      "displayName": "Weekly sales, profit and margin",
      "queryLines": [
        "-- Complete weeks only, so a partially loaded final week does not plunge the trend.\n",
        "SELECT\n",
        "  DATE_TRUNC('WEEK', order_date)          AS week,\n",
        "  SUM(total_sales)                        AS sales,\n",
        "  SUM(total_profit)                       AS profit,\n",
        "  SUM(total_profit) / SUM(total_sales)    AS margin\n",
        "FROM metrics_daily_kpi\n",
        "GROUP BY 1\n",
        "HAVING COUNT(*) = 7\n"
      ]
    },
    {
      "name": "category_mix",
      "displayName": "Sales by category",
      "queryLines": [
        "SELECT category, SUM(total_sales) AS sales, SUM(total_profit) AS profit\n",
        "FROM product_insights_kpi\n",
        "WHERE category <> 'Unknown'\n",
        "GROUP BY category\n"
      ]
    },
    {
      "name": "top_subcategories",
      "displayName": "Top 15 sub-categories by revenue",
      "queryLines": [
        "-- Top 15 only: the generator also emits ~250k one-off \"Random Product\" rows,\n",
        "-- each with its own numeric sub-category, which would bury the real ones.\n",
        "SELECT category, sub_category, SUM(total_sales) AS sales\n",
        "FROM product_insights_kpi\n",
        "WHERE category <> 'Unknown'\n",
        "GROUP BY category, sub_category\n",
        "ORDER BY sales DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "run_comparison",
      "displayName": "This run vs last run",
      "queryLines": [
        "-- One row per pipeline run is recorded in kpi_run_snapshot (superstore_kpi_snapshot.py).\n",
        "-- This shows the latest two side by side, so a jump can be read as new data\n",
        "-- (data covers more days) or restated history (same days, different totals).\n",
        "WITH ranked AS (\n",
        "  SELECT *, ROW_NUMBER() OVER (ORDER BY snapshot_at DESC) AS rn FROM kpi_run_snapshot\n",
        "),\n",
        "c AS (SELECT * FROM ranked WHERE rn = 1),\n",
        "p AS (SELECT * FROM ranked WHERE rn = 2),\n",
        "j AS (\n",
        "  SELECT\n",
        "    c.data_from AS c_data_from,\n",
        "    c.data_through AS c_data_through,\n",
        "    c.snapshot_at AS c_snapshot_at,\n",
        "    c.run_started_at AS c_run_started_at,\n",
        "    c.trigger_type AS c_trigger_type,\n",
        "    c.raw_rows_ingested AS c_raw_rows_ingested,\n",
        "    c.revenue_30d AS c_revenue_30d,\n",
        "    c.profit_30d AS c_profit_30d,\n",
        "    c.revenue_total AS c_revenue_total,\n",
        "    c.profit_total AS c_profit_total,\n",
        "    c.orders_total AS c_orders_total,\n",
        "    c.customers_total AS c_customers_total,\n",
        "    p.data_from AS p_data_from,\n",
        "    p.data_through AS p_data_through,\n",
        "    p.snapshot_at AS p_snapshot_at,\n",
        "    p.run_started_at AS p_run_started_at,\n",
        "    p.trigger_type AS p_trigger_type,\n",
        "    p.raw_rows_ingested AS p_raw_rows_ingested,\n",
        "    p.revenue_30d AS p_revenue_30d,\n",
        "    p.profit_30d AS p_profit_30d,\n",
        "    p.revenue_total AS p_revenue_total,\n",
        "    p.profit_total AS p_profit_total,\n",
        "    p.orders_total AS p_orders_total,\n",
        "    p.customers_total AS p_customers_total\n",
        "  FROM c LEFT JOIN p ON TRUE\n",
        ")\n",
        "SELECT 1 AS ord, 'This run' AS run,\n",
        "  IF(c_data_from IS NULL, '—', CONCAT(DATE_FORMAT(c_data_from, 'd MMM yyyy'), ' – ', DATE_FORMAT(c_data_through, 'd MMM yyyy'))) AS data_covers,\n",
        "  IF(c_snapshot_at IS NULL, '—', CONCAT(DATE_FORMAT(from_utc_timestamp(c_snapshot_at, 'Australia/Sydney'), 'EEE d MMM, HH:mm'), ' ', IF(unix_timestamp(from_utc_timestamp(c_snapshot_at, 'Australia/Sydney')) - unix_timestamp(c_snapshot_at) = 39600, 'AEDT', 'AEST'))) AS refreshed,\n",
        "  CASE c_trigger_type WHEN 'periodic' THEN 'scheduled' WHEN 'one_time' THEN 'manual' WHEN 'run_job_task' THEN 'integration test' WHEN NULL THEN '—' ELSE c_trigger_type END AS trigger,\n",
        "  CASE WHEN (c_revenue_30d) IS NULL THEN '—' WHEN ABS((c_revenue_30d)) >= 1e9 THEN CONCAT(IF((c_revenue_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((c_revenue_30d)) / 1e9, 2), 'bn') WHEN ABS((c_revenue_30d)) >= 1e6 THEN CONCAT(IF((c_revenue_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((c_revenue_30d)) / 1e6, 2), 'm') WHEN ABS((c_revenue_30d)) >= 1e3 THEN CONCAT(IF((c_revenue_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((c_revenue_30d)) / 1e3, 1), 'k') ELSE CONCAT(IF((c_revenue_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((c_revenue_30d)), 0)) END AS revenue,\n",
        "  CASE WHEN (c_profit_30d) IS NULL THEN '—' WHEN ABS((c_profit_30d)) >= 1e9 THEN CONCAT(IF((c_profit_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((c_profit_30d)) / 1e9, 2), 'bn') WHEN ABS((c_profit_30d)) >= 1e6 THEN CONCAT(IF((c_profit_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((c_profit_30d)) / 1e6, 2), 'm') WHEN ABS((c_profit_30d)) >= 1e3 THEN CONCAT(IF((c_profit_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((c_profit_30d)) / 1e3, 1), 'k') ELSE CONCAT(IF((c_profit_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((c_profit_30d)), 0)) END AS profit,\n",
        "  IF((c_profit_30d / NULLIF(c_revenue_30d, 0)) IS NULL, '—', CONCAT(REPLACE(FORMAT_NUMBER((c_profit_30d / NULLIF(c_revenue_30d, 0)) * 100, 1), '-', '−'), '%')) AS margin\n",
        "FROM j\n",
        "UNION ALL\n",
        "SELECT 2 AS ord, 'Last run' AS run,\n",
        "  IF(p_data_from IS NULL, '—', CONCAT(DATE_FORMAT(p_data_from, 'd MMM yyyy'), ' – ', DATE_FORMAT(p_data_through, 'd MMM yyyy'))) AS data_covers,\n",
        "  IF(p_snapshot_at IS NULL, '—', CONCAT(DATE_FORMAT(from_utc_timestamp(p_snapshot_at, 'Australia/Sydney'), 'EEE d MMM, HH:mm'), ' ', IF(unix_timestamp(from_utc_timestamp(p_snapshot_at, 'Australia/Sydney')) - unix_timestamp(p_snapshot_at) = 39600, 'AEDT', 'AEST'))) AS refreshed,\n",
        "  CASE p_trigger_type WHEN 'periodic' THEN 'scheduled' WHEN 'one_time' THEN 'manual' WHEN 'run_job_task' THEN 'integration test' WHEN NULL THEN '—' ELSE p_trigger_type END AS trigger,\n",
        "  CASE WHEN (p_revenue_30d) IS NULL THEN '—' WHEN ABS((p_revenue_30d)) >= 1e9 THEN CONCAT(IF((p_revenue_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((p_revenue_30d)) / 1e9, 2), 'bn') WHEN ABS((p_revenue_30d)) >= 1e6 THEN CONCAT(IF((p_revenue_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((p_revenue_30d)) / 1e6, 2), 'm') WHEN ABS((p_revenue_30d)) >= 1e3 THEN CONCAT(IF((p_revenue_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((p_revenue_30d)) / 1e3, 1), 'k') ELSE CONCAT(IF((p_revenue_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((p_revenue_30d)), 0)) END AS revenue,\n",
        "  CASE WHEN (p_profit_30d) IS NULL THEN '—' WHEN ABS((p_profit_30d)) >= 1e9 THEN CONCAT(IF((p_profit_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((p_profit_30d)) / 1e9, 2), 'bn') WHEN ABS((p_profit_30d)) >= 1e6 THEN CONCAT(IF((p_profit_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((p_profit_30d)) / 1e6, 2), 'm') WHEN ABS((p_profit_30d)) >= 1e3 THEN CONCAT(IF((p_profit_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((p_profit_30d)) / 1e3, 1), 'k') ELSE CONCAT(IF((p_profit_30d) < 0, '−$', '$'), FORMAT_NUMBER(ABS((p_profit_30d)), 0)) END AS profit,\n",
        "  IF((p_profit_30d / NULLIF(p_revenue_30d, 0)) IS NULL, '—', CONCAT(REPLACE(FORMAT_NUMBER((p_profit_30d / NULLIF(p_revenue_30d, 0)) * 100, 1), '-', '−'), '%')) AS margin\n",
        "FROM j\n",
        "UNION ALL\n",
        "SELECT 3 AS ord, 'Change' AS run,\n",
        "  CASE WHEN p_data_through IS NULL THEN '—' WHEN c_data_through = p_data_through AND c_data_from = p_data_from THEN 'same period' ELSE CONCAT(IF(datediff(c_data_through, p_data_through) >= 0, '+', ''), datediff(c_data_through, p_data_through), ' days of data') END AS data_covers,\n",
        "  IF(p_snapshot_at IS NULL, '—', CONCAT(FORMAT_NUMBER((unix_timestamp(c_snapshot_at) - unix_timestamp(p_snapshot_at)) / 3600, 1), ' h later')) AS refreshed,\n",
        "  '' AS trigger,\n",
        "  CASE WHEN (c_revenue_30d - p_revenue_30d) IS NULL THEN '—' WHEN (c_revenue_30d - p_revenue_30d) = 0 THEN 'no change' WHEN ABS((c_revenue_30d - p_revenue_30d)) >= 1e9 THEN CONCAT(IF((c_revenue_30d - p_revenue_30d) < 0, '▼ −$', '▲ +$'), FORMAT_NUMBER(ABS((c_revenue_30d - p_revenue_30d)) / 1e9, 2), 'bn') WHEN ABS((c_revenue_30d - p_revenue_30d)) >= 1e6 THEN CONCAT(IF((c_revenue_30d - p_revenue_30d) < 0, '▼ −$', '▲ +$'), FORMAT_NUMBER(ABS((c_revenue_30d - p_revenue_30d)) / 1e6, 2), 'm') WHEN ABS((c_revenue_30d - p_revenue_30d)) >= 1e3 THEN CONCAT(IF((c_revenue_30d - p_revenue_30d) < 0, '▼ −$', '▲ +$'), FORMAT_NUMBER(ABS((c_revenue_30d - p_revenue_30d)) / 1e3, 1), 'k') ELSE CONCAT(IF((c_revenue_30d - p_revenue_30d) < 0, '▼ −$', '▲ +$'), FORMAT_NUMBER(ABS((c_revenue_30d - p_revenue_30d)), 0)) END AS revenue,\n",
        "  CASE WHEN (c_profit_30d - p_profit_30d) IS NULL THEN '—' WHEN (c_profit_30d - p_profit_30d) = 0 THEN 'no change' WHEN ABS((c_profit_30d - p_profit_30d)) >= 1e9 THEN CONCAT(IF((c_profit_30d - p_profit_30d) < 0, '▼ −$', '▲ +$'), FORMAT_NUMBER(ABS((c_profit_30d - p_profit_30d)) / 1e9, 2), 'bn') WHEN ABS((c_profit_30d - p_profit_30d)) >= 1e6 THEN CONCAT(IF((c_profit_30d - p_profit_30d) < 0, '▼ −$', '▲ +$'), FORMAT_NUMBER(ABS((c_profit_30d - p_profit_30d)) / 1e6, 2), 'm') WHEN ABS((c_profit_30d - p_profit_30d)) >= 1e3 THEN CONCAT(IF((c_profit_30d - p_profit_30d) < 0, '▼ −$', '▲ +$'), FORMAT_NUMBER(ABS((c_profit_30d - p_profit_30d)) / 1e3, 1), 'k') ELSE CONCAT(IF((c_profit_30d - p_profit_30d) < 0, '▼ −$', '▲ +$'), FORMAT_NUMBER(ABS((c_profit_30d - p_profit_30d)), 0)) END AS profit,\n",
        "  CASE WHEN (c_profit_30d / NULLIF(c_revenue_30d, 0) - p_profit_30d / NULLIF(p_revenue_30d, 0)) IS NULL THEN '—' WHEN ROUND((c_profit_30d / NULLIF(c_revenue_30d, 0) - p_profit_30d / NULLIF(p_revenue_30d, 0)) * 100, 2) = 0 THEN 'no change' ELSE CONCAT(IF((c_profit_30d / NULLIF(c_revenue_30d, 0) - p_profit_30d / NULLIF(p_revenue_30d, 0)) < 0, '▼ −', '▲ +'), FORMAT_NUMBER(ABS((c_profit_30d / NULLIF(c_revenue_30d, 0) - p_profit_30d / NULLIF(p_revenue_30d, 0))) * 100, 2), ' pp') END AS margin\n",
        "FROM j\n",
        "ORDER BY ord\n"
      ]
    },
    {
      "name": "page_status",
      "displayName": "Page query time and freshness",
      "queryLines": [
        "-- Query time is when this page ran its queries: it changes on every refresh of\n",
        "-- the page, unlike the data refresh time. Freshness uses the same 9-day (216 h)\n",
        "-- threshold as the freshness alert; prod refreshes weekly, Sundays 06:00.\n",
        "SELECT\n",
        "  IF(current_timestamp() IS NULL, '—', CONCAT(DATE_FORMAT(from_utc_timestamp(current_timestamp(), 'Australia/Sydney'), 'EEE d MMM, HH:mm'), ' ', IF(unix_timestamp(from_utc_timestamp(current_timestamp(), 'Australia/Sydney')) - unix_timestamp(current_timestamp()) = 39600, 'AEDT', 'AEST'))) AS queried,\n",
        "  CASE\n",
        "    WHEN MAX(snapshot_at) IS NULL THEN 'No run recorded'\n",
        "    WHEN (unix_timestamp(current_timestamp()) - unix_timestamp(MAX(snapshot_at))) / 3600 <= 216 THEN 'Fresh'\n",
        "    ELSE 'Stale (9+ days)'\n",
        "  END AS status\n",
        "FROM kpi_run_snapshot\n"
      ]
    }
  ],
